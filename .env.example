# Discord Developer Portal -> your application
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_client_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret

# The exact public URL of the dashboard. For local Docker use http://localhost:3000
PUBLIC_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string

# Optional: Discord user ID that can view the private bot usage dashboard.
# This is the bot owner's Discord user ID, not the bot/application ID.
# BOT_OWNER_ID=replace_with_discord_user_id

# Optional: set to a local timezone for dashboard timestamps.
TZ=UTC

# Optional YouTube authentication for hosted deployments. The path is inside
# the container; mount the cookie file read-only in docker-compose.yml.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# When configured, YouTube requests use only the authenticated YouTube path;
# SoundCloud and Piped fallbacks are skipped to avoid extra search attempts.
# Optional: browser User-Agent used when the cookies were exported.
# YTDLP_USER_AGENT=Mozilla/5.0 ...

# PO-token support is configured automatically by docker-compose.yml.
# These are only needed when running the bot outside that Compose setup:
# YTDLP_PLAYER_CLIENT=mweb
# YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416

# Optional alternate YouTube transport. Piped is a proxy/API for YouTube; it
# is only used when direct YouTube extraction fails. Use a trusted instance.
# Comma-separated Piped API URLs. They are tried in order; failed or empty
# instances are skipped. Docker supplies a small default pool automatically.
# PIPED_API_URLS=https://pipedapi.kavin.rocks,https://pipedapi.leptons.xyz,https://pipedapi.nosebs.ru

# Persistent uploaded audio library. The library is stored under /app/data in
# Docker and is normalized to Opus before the original upload is removed.
# Song uploads are disabled by default; set this to true to enable dashboard uploads.
# LIBRARY_UPLOADS_ENABLED=false
# LIBRARY_MAX_GB=20
# LIBRARY_MAX_MINUTES=5
# LIBRARY_MAX_UPLOAD_MB=50
# LIBRARY_MAX_GUILD_GB=5
# LIBRARY_MAX_USER_GB=1

# Optional hardening and resource limits. The defaults are shown.
# How long Discord server permissions are cached before being re-read (minutes).
# GUILD_CACHE_MINUTES=5
# Maximum tracks a single server queue can hold.
# QUEUE_MAX_TRACKS=100
# Time limit for a single yt-dlp or ffprobe run.
# MEDIA_TIMEOUT_SECONDS=45
# How many yt-dlp/ffmpeg helper processes may run at once across all servers.
# MEDIA_MAX_CONCURRENCY=4

# Optional Spotify playlist importing. Create an app at https://developer.spotify.com/dashboard
# and provide its Client ID and Client Secret. Spotify is used for playlist metadata;
# tracks are matched to the existing YouTube/SoundCloud playback providers.
# SPOTIFY_CLIENT_ID=replace_with_spotify_client_id
# SPOTIFY_CLIENT_SECRET=replace_with_spotify_client_secret
# SPOTIFY_MARKET=US
